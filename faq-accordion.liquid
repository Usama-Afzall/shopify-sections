{% comment %}
  FAQ Accordion
  -------------
  Question/answer blocks rendered with native <details>/<summary>, so the accordion is
  keyboard and screen reader accessible and works without any JavaScript.

  - Optional "one open at a time" mode uses the native <details name="..."> grouping.
    Browsers without support for it simply allow several items to stay open.
  - Optionally outputs FAQPage structured data (JSON-LD) built from the same blocks,
    so the markup and the schema can never drift apart.
  - All CSS is scoped to this section instance.
{% endcomment %}

{%- style -%}
  .faq-{{ section.id }} {
    background: {{ section.settings.color_background }};
    color: {{ section.settings.color_text }};
    padding: {{ section.settings.padding_top }}px 1.5rem {{ section.settings.padding_bottom }}px;
  }
  .faq-{{ section.id }} .faq__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }
  .faq-{{ section.id }} .faq__heading {
    margin: 0 0 0.5rem;
    color: inherit;
    text-align: {{ section.settings.heading_alignment }};
  }
  .faq-{{ section.id }} .faq__intro {
    margin: 0 0 1.5rem;
    text-align: {{ section.settings.heading_alignment }};
    opacity: 0.8;
  }
  .faq-{{ section.id }} .faq__item {
    border-bottom: 1px solid {{ section.settings.color_border }};
  }
  .faq-{{ section.id }} .faq__item:first-of-type {
    border-top: 1px solid {{ section.settings.color_border }};
  }
  .faq-{{ section.id }} .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0;
    font-weight: 600;
    line-height: 1.4;
    cursor: pointer;
    list-style: none; /* hide the default disclosure triangle */
  }
  .faq-{{ section.id }} .faq__question::-webkit-details-marker {
    display: none;
  }
  .faq-{{ section.id }} .faq__question:focus-visible {
    outline: 2px solid {{ section.settings.color_accent }};
    outline-offset: 2px;
  }
  /* Plus icon drawn with two bars; the vertical bar collapses when the item is open. */
  .faq-{{ section.id }} .faq__icon {
    position: relative;
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    color: {{ section.settings.color_accent }};
  }
  .faq-{{ section.id }} .faq__icon::before,
  .faq-{{ section.id }} .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    margin-top: -1px;
    background: currentColor;
    transition: transform 0.2s ease;
  }
  .faq-{{ section.id }} .faq__icon::after {
    transform: rotate(90deg);
  }
  .faq-{{ section.id }} .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }
  .faq-{{ section.id }} .faq__answer {
    padding: 0 2rem 1.25rem 0;
    line-height: 1.6;
  }
  .faq-{{ section.id }} .faq__answer > :first-child { margin-top: 0; }
  .faq-{{ section.id }} .faq__answer > :last-child { margin-bottom: 0; }
  .faq-{{ section.id }} .faq__answer a {
    color: {{ section.settings.color_accent }};
    text-decoration: underline;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-{{ section.id }} .faq__icon::before,
    .faq-{{ section.id }} .faq__icon::after {
      transition: none;
    }
  }
{%- endstyle -%}

<div class="faq-{{ section.id }}">
  <div class="faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="faq__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.settings.question == blank -%}
        {%- continue -%}
      {%- endif -%}
      <details
        class="faq__item"
        {% if section.settings.single_open %}name="faq-{{ section.id }}"{% endif %}
        {% if section.settings.open_first and forloop.first %}open{% endif %}
        {{ block.shopify_attributes }}
      >
        <summary class="faq__question">
          <span>{{ block.settings.question | escape }}</span>
          <span class="faq__icon" aria-hidden="true"></span>
        </summary>
        <div class="faq__answer rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

{%- comment -%}
  FAQPage JSON-LD.
  - Only blocks with both a question and an answer are included.
  - Answers are reduced to plain text; a space is added before closing block tags first
    so paragraphs and list items do not run together once the HTML is stripped.
  - The json filter handles quoting and escaping, so merchant text cannot break the JSON.
  - Schema.org expects one FAQPage per URL: enable this on a single FAQ section per page.
{%- endcomment -%}
{%- if section.settings.enable_schema -%}
  {%- capture faq_entities -%}
    {%- assign is_first = true -%}
    {%- for block in section.blocks -%}
      {%- assign question = block.settings.question | strip -%}
      {%- assign answer = block.settings.answer | replace: '</p>', ' </p>' | replace: '</li>', ' </li>' | strip_html | strip -%}
      {%- if question == blank or answer == blank -%}
        {%- continue -%}
      {%- endif -%}
      {%- unless is_first -%},{%- endunless -%}
      {
        "@type": "Question",
        "name": {{ question | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ answer | json }}
        }
      }
      {%- assign is_first = false -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if faq_entities != blank -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [{{ faq_entities }}]
      }
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "FAQ accordion",
  "tag": "section",
  "class": "section-faq-accordion",
  "max_blocks": 30,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "info": "Uses the theme's own heading classes (available in Dawn and most Online Store 2.0 themes).",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "intro", "label": "Intro text" },
    { "type": "header", "content": "Behavior" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question on page load", "default": false },
    { "type": "checkbox", "id": "single_open", "label": "Only one question open at a time", "default": true },
    { "type": "header", "content": "SEO" },
    {
      "type": "checkbox",
      "id": "enable_schema",
      "label": "Output FAQ structured data (JSON-LD)",
      "default": true,
      "info": "Enable on one FAQ section per page."
    },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Content max width", "min": 500, "max": 1200, "step": 50, "unit": "px", "default": 800 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#1a1a1a" },
    { "type": "color", "id": "color_border", "label": "Divider lines", "default": "#e3e3e3" },
    { "type": "color", "id": "color_accent", "label": "Icon, links and focus ring", "default": "#1a1a1a" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is your return policy?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer the question clearly and briefly. You can add links, lists and bold text here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        { "type": "question", "settings": { "question": "How long does shipping take?" } },
        { "type": "question", "settings": { "question": "What is your return policy?" } },
        { "type": "question", "settings": { "question": "How can I contact support?" } }
      ]
    }
  ]
}
{% endschema %}
